# Copia este archivo como .env SOLO para probar en tu computador.
# En Vercel estas variables se definen en: Project → Settings → Environment Variables.
# Nunca subas tu .env a GitHub (el .gitignore ya lo excluye).

# URL del webhook personalizado de Make (la que muestra el módulo «Custom webhook»)
MAKE_WEBHOOK_URL=https://hook.us2.make.com/PEGA_AQUI_TU_CODIGO
# Clave de API del webhook (la que creaste en «API key authentication» de Make)
MAKE_API_KEY=cambia-esto-por-una-clave-larga

# Opcionales
# ACCESS_CODE=       # si lo defines, la pantalla pedirá este código antes de analizar
# MAX_POR_MINUTO=8   # consultas por minuto y por visitante
