# Copia este archivo como .env SOLO para probar en tu computador.
# En Vercel estas variables se definen en: Project → Settings → Environment Variables.
# Nunca subas tu .env a GitHub (el .gitignore ya lo excluye).

# Tu clave de OpenRouter (https://openrouter.ai/keys). Ponle un límite de crédito a la clave.
OPENROUTER_API_KEY=sk-or-v1-PEGA_AQUI_TU_CLAVE

# Publicación en redes (MVP híbrido). El panel "Aprobar y publicar" se activa si hay al menos un backend configurado.

# TikTok vía Zernio (https://zernio.com/dashboard/api-keys)
# ZERNIO_API_KEY=
# ZERNIO_PROFILE_ID=     # opcional: "default" o vacío usa el perfil por defecto
# ZERNIO_PUBLICAR=       # "ahora" publica de inmediato; por defecto crea un BORRADOR en Zernio

# Facebook e Instagram vía Meta Graph API (developers.facebook.com). Para tus propias cuentas basta modo desarrollo.
# META_PAGE_ID=              # id de tu Página de Facebook
# META_PAGE_ACCESS_TOKEN=    # token de la Página (larga duración)
# META_IG_USER_ID=           # id de tu cuenta de Instagram Business vinculada a la Página
# META_PUBLICAR=             # "ahora" publica en vivo; por defecto la de Facebook queda sin publicar (revisión)
# META_GRAPH_VERSION=v21.0

# Imagen de Instagram (OpenAI). IG exige imagen; sin esto no se puede publicar en IG.
# OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1-mini   # por defecto; devuelve base64 y se hospeda en Zernio (requiere ZERNIO_API_KEY)

# Opcionales
# ACCESS_CODE=       # si lo defines, la pantalla pedirá este código antes de generar o publicar
# MAX_POR_MINUTO=8   # consultas por minuto y por visitante
# MODEL_ID=          # otro modelo de OpenRouter; por defecto el del curso
# OPENROUTER_BASE_URL=   # otro proveedor compatible con OpenAI (por defecto, OpenRouter)
